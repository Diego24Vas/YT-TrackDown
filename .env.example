# ==============================================================================
# YT-TrackDown — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env para personalizar tu configuración:
#   cp .env.example .env
# ==============================================================================

# Puerto y Host del servidor web
PORT=8080
HOST=0.0.0.0

# Concurrencia y límites del pool de descargas
MAX_CONCURRENT_DOWNLOADS=2

# Calidad de audio por defecto en kbps (opciones: 128, 192, 256, 320)
DEFAULT_AUDIO_QUALITY=192

# Retención de archivos y limpieza automática
# Tiempo (en minutos) antes de eliminar los audios descargados
FILE_RETENTION_MINUTES=15

# Intervalo (en segundos) para la verificación de archivos expirados
CLEANUP_CHECK_INTERVAL_SECONDS=30

# Rutas de ejecutables externos (opcional, detección automática en PATH si se omite)
# FFMPEG_LOCATION=/usr/bin/ffmpeg
# NODE_PATH=/usr/bin/node
